{
  "manifest_version": 3,
  "name": "悬浮便签 · 记录与一键复制",
  "version": "1.1.0",
  "description": "在任意页面上随手记 bug / 想法 / 优化点：面板与收起后的胶囊都能拖动、点别处自动收起，按站点保存，一键复制成给 AI 的清单。",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "显示 / 隐藏便签（Alt+Shift+S）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-sticky": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "显示 / 隐藏便签"
    },
    "quick-add": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "快速添加一条（展开并聚焦输入框）"
    }
  }
}
